{
  "manifest_version": 3,
  "name": "Better Teambuilder for Showdown!",
  "version": "0.1.0",
  "description": "Adds movepool- and ability-derived custom search filters to the Pokémon Showdown teambuilder's Pokémon and Move search.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://play.pokemonshowdown.com/*"],
      "js": ["src/move-data.js", "src/content.js"],
      "css": ["src/style.css"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
