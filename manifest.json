{
  "manifest_version": 3,
  "name": "Better Teambuilder for Showdown!",
  "version": "0.1.0",
  "description": "Adds custom movepool/ability filters, a Speed filter, Pikalytics stats, and Speed Tiers comparisons to the Showdown teambuilder.",
  "homepage_url": "https://www.patreon.com/cw/yajaman",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://play.pokemonshowdown.com/*"],
      "js": ["src/defaults.js", "src/settings-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://play.pokemonshowdown.com/*"],
      "js": ["src/move-data.js", "src/pikalytics.js", "src/content.js"],
      "css": ["src/style.css"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
