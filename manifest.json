{
  "manifest_version": 3,
  "name": "Better Teambuilder for Showdown!",
  "version": "0.1.0",
  "description": "Adds movepool/ability search filters, a Speed filter, a click-to-apply Pikalytics stats panel, and a Speed Tiers panel with a head-to-head Speed comparison popup to the Showdown teambuilder.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://play.pokemonshowdown.com/*"],
      "js": ["src/defaults.js", "src/settings-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://play.pokemonshowdown.com/*"],
      "js": ["src/move-data.js", "src/pikalytics.js", "src/content.js"],
      "css": ["src/style.css"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
